# ============================================================
# Library Management System — Environment Variables
# Copy this file to .env and fill in your values.
# For local dev, the defaults in application.properties work
# without any changes. Only set these for production.
# ============================================================

# --- Database ---
DATABASE_URL=jdbc:postgresql://localhost:5432/librarydb
DATABASE_USER=postgres
DATABASE_PASSWORD=your_postgres_password

# --- JWT ---
# Must be at least 32 characters for HS256
JWT_SECRET=LibraryManagementSystemSecretKeyForJWTTokenGeneration2026SecureKey
JWT_EXPIRATION=86400000

# --- CORS ---
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# --- Email (optional — leave blank to disable) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_gmail@gmail.com
MAIL_PASSWORD=your_gmail_app_password

# --- Twilio SMS (optional — leave blank to disable) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- File Upload ---
UPLOAD_DIR=uploads/avatars
MAX_UPLOAD_SIZE=2097152
